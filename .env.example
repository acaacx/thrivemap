# ThriveMap environment configuration
# Copy to .env.local and fill in values. Every optional provider key that is
# left empty makes the app fall back to a clearly-marked local dev adapter.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---
# Local development: run `pnpm exec supabase start` and copy values from
# `pnpm exec supabase status`. Production: from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Google Maps Platform (optional — dev map adapter used when empty) ---
# Browser key: restrict by HTTP referrer + enable only Maps JavaScript API.
# Server key: restrict by IP + enable Places (New) Text Search, Geocoding.
# When empty, the candidate importer serves deterministic fixtures
# ([DEV ADAPTER]) so the admin import flow works offline.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# --- Upstash Redis (optional — in-memory rate limiter/cache when empty) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend email (optional — emails logged to console when empty) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@thrivemap.local

# --- Background jobs ---
# Shared secret required by /api/internal/jobs/process. Generate with:
# openssl rand -hex 24
# On Vercel, also set CRON_SECRET to this same value: Vercel Cron sends it as
# "Authorization: Bearer $CRON_SECRET" on the GET tick declared in vercel.json.
JOBS_PROCESSOR_SECRET=

# --- Observability / analytics (optional — no-ops when empty) ---
# Server/edge capture. Same DSN value as the browser one below; kept as two
# vars so the server key is never inlined into the client bundle by accident.
SENTRY_DSN=
# Browser capture. Safe to expose — a DSN is an ingest endpoint, not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: fraction of transactions traced. Both default to 0.1.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only — needed to upload source maps so stack traces are readable.
# Never required at runtime; builds succeed without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
