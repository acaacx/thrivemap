  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
